<Window x:Class="SetupApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuifeiCrypto 安装向导"
        Width="820" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Microsoft YaHei UI"
        Icon="app.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6368"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E2E6EC"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#F3F6FA"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F6FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C9CED6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区 -->
        <Border Grid.Row="0" Background="{StaticResource SoftBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="10"
                        Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="G" Foreground="White" FontSize="26" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="GuifeiCrypto 安装向导" FontSize="20"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="安装文件加密工具与 AI 模型"
                               FontSize="12.5" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1" Margin="40,26,40,0">

            <!-- 第 1 步：欢迎 -->
            <StackPanel x:Name="WelcomePanel">
                <TextBlock Text="欢迎使用 GuifeiCrypto 安装向导" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="13.5" LineHeight="24"
                           Foreground="{StaticResource MutedBrush}"
                           Text="本向导将把 GuifeiCrypto 安装到你的电脑，并注册右键菜单。安装包已包含 Python 运行时、人脸与声纹模型，安装完成后无需联网、无需再安装其他组件。"/>
                <Border Margin="0,22,0,0" Background="{StaticResource SoftBrush}" CornerRadius="6" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="安装内容" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="12.5" LineHeight="22" Foreground="{StaticResource MutedBrush}"
                                   Text="• 主程序（文件 / 文件夹 / 文档加密，含人脸与声纹因子）&#10;• AES-256-GCM 加密核心与 BCH 纠错&#10;• 人脸识别模型 buffalo_l 与声纹模型&#10;• 资源管理器右键菜单（加密 / 解密）"/>
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,20,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="点击“下一步”继续。"/>
            </StackPanel>

            <!-- 第 2 步：安装位置 -->
            <StackPanel x:Name="PathPanel" Visibility="Collapsed">
                <TextBlock Text="选择安装位置" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="{StaticResource MutedBrush}"
                           Text="安装到当前用户目录，不需要管理员权限。"/>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallDirBox" Grid.Column="0" Style="{StaticResource PathBox}"/>
                    <Button Grid.Column="1" x:Name="BrowseButton" Content="浏览…" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Height="34" Click="Browse_Click"/>
                </Grid>
                <TextBlock x:Name="DiskInfoText" Margin="0,10,0,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
                <StackPanel Margin="0,22,0,0">
                    <CheckBox x:Name="DesktopShortcutCheck" Content="创建桌面快捷方式" IsChecked="True"
                              FontSize="13" Margin="0,1"/>
                    <CheckBox x:Name="StartMenuCheck" Content="创建开始菜单快捷方式" IsChecked="True"
                              FontSize="13" Margin="0,12,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 第 3 步：安装进度 -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock Text="正在安装" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="StatusText" Margin="0,14,0,0" FontSize="13"
                           Foreground="{StaticResource TextBrush}" Text="准备安装…"/>
                <ProgressBar x:Name="InstallProgress" Margin="0,14,0,0" Height="18"
                             Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="DetailText" Margin="0,12,0,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="安装过程中请不要关闭窗口。"/>
            </StackPanel>

            <!-- 第 4 步：完成 -->
            <StackPanel x:Name="FinishPanel" Visibility="Collapsed">
                <TextBlock Text="安装完成" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Margin="0,12,0,0" FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" LineHeight="24"
                           Text="GuifeiCrypto 已成功安装。右键点击文件即可看到“用 GuifeiCrypto 加密”，右键加密文件可以快速解密。"/>
                <CheckBox x:Name="RunAfterCheck" Margin="0,22,0,0" FontSize="13"
                          Content="立即运行 GuifeiCrypto" IsChecked="True"/>
                <TextBlock x:Name="FinishPathText" Margin="0,14,0,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource SoftBrush}">
            <Grid Margin="32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ModeText" Grid.Column="0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}"
                            Click="Back_Click" IsEnabled="False"/>
                    <Button x:Name="NextButton" Content="下一步" Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButton}" Click="Next_Click"/>
                    <Button x:Name="CancelButton" Content="取消" Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
